#!/bin/bash
set -euo pipefail
umask 077

%{ if !assets_ready ~}
printf 'required deployment asset missing\n' >&2
exit 1
%{ endif ~}

dnf install -y docker jq postgresql15

command -v curl >/dev/null
curl --version >/dev/null
command -v aws >/dev/null
aws_version="$(aws --version 2>&1)"
case "$aws_version" in
  aws-cli/2.*) ;;
  *) printf 'AWS CLI v2 is required\n' >&2; exit 1 ;;
esac

compose_version='v5.5.0'
compose_expected_version='5.5.0'
compose_sha256='ff42489f5a9b879d5d117c5ffea6defc27390b3286da8ad52cbc9c6ab5df590e'
compose_path='/usr/local/lib/docker/cli-plugins/docker-compose'
compose_installed_version="$(docker compose version --short 2>/dev/null || true)"
if [ "$compose_installed_version" != "$compose_expected_version" ]; then
  install -d -m 0755 -o root -g root "$(dirname "$compose_path")"
  compose_tmp="$(mktemp)"
  trap 'unlink "$compose_tmp" 2>/dev/null || true' EXIT
  curl --fail --show-error --location --retry 3 \
    --output "$compose_tmp" \
    "https://github.com/docker/compose/releases/download/$compose_version/docker-compose-linux-aarch64"
  printf '%s  %s\n' "$compose_sha256" "$compose_tmp" | sha256sum -c -
  install -m 0755 -o root -g root "$compose_tmp" "$compose_path"
  unlink "$compose_tmp"
  trap - EXIT
fi
test "$(docker compose version --short)" = "$compose_expected_version"

install -d -m 0755 -o root -g root /opt/jobcron
install -d -m 0700 -o root -g root /etc/jobcron

%{ for target, asset in assets ~}
install -d -m 0755 -o root -g root "$(dirname "${target}")"
asset_tmp="$(mktemp)"
printf '%s' '${asset.payload}' | base64 -d | gzip -d >"$asset_tmp"
printf '%s  %s\n' '${asset.sha256}' "$asset_tmp" | sha256sum -c -
install -m '${asset.mode}' -o root -g root "$asset_tmp" "${target}"
rm -f "$asset_tmp"
%{ endfor ~}

printf '%s\n' '${runtime_secret_arn}' \
  >"/etc/jobcron/runtime-secret-id"
chmod 0600 /etc/jobcron/runtime-secret-id

systemctl daemon-reload
systemctl enable docker.service jobcron-recovery.timer
systemctl start docker.service
systemctl stop jobcron.service
